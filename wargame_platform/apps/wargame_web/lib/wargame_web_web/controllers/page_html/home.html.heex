<div class="min-h-screen bg-gray-900 text-white">
  <%!-- Hero Section --%>
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-16 text-center">
      <h1 class="text-5xl font-bold tracking-tight mb-4">Wargame Platform</h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Design maps, create scenarios, and play hex-based wargames with AI opponents
      </p>
    </div>
  </div>

  <%!-- Quick Actions --%>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%!-- Play --%>
      <a href="/games" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-blue-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-blue-400 transition-colors">Play Games</h2>
        </div>
        <p class="text-gray-400 text-sm">Start a new game or continue an existing one. Choose a scenario and play against the AI.</p>
      </a>

      <%!-- Quick Start --%>
      <a href="/games/new" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-green-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-green-400 transition-colors">Quick Start</h2>
        </div>
        <p class="text-gray-400 text-sm">Jump straight into a test battle with a pre-built scenario and sample units.</p>
      </a>

      <%!-- Map Editor --%>
      <a href="/map-editor" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-amber-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-amber-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-amber-400 transition-colors">Map Editor</h2>
        </div>
        <p class="text-gray-400 text-sm">Design hex maps with terrain, elevation, roads, rivers, and satellite imagery.</p>
      </a>

      <%!-- Unit Editor --%>
      <a href="/unit-editor" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-purple-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-purple-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-purple-400 transition-colors">Unit Templates</h2>
        </div>
        <p class="text-gray-400 text-sm">Create and edit unit types with combat stats, movement, and NATO symbology.</p>
      </a>

      <%!-- Leader Editor --%>
      <a href="/leader-editor" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-red-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-red-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-red-400 transition-colors">Leaders</h2>
        </div>
        <p class="text-gray-400 text-sm">Define commander characters with modifiers, abilities, and command radii.</p>
      </a>

      <%!-- Scenario Editor --%>
      <a href="/scenario-editor" class="group block bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-cyan-500 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-cyan-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold group-hover:text-cyan-400 transition-colors">Scenarios</h2>
        </div>
        <p class="text-gray-400 text-sm">Build scenarios with OOBs, deployment zones, victory conditions, and weather.</p>
      </a>
    </div>
  </div>

  <%!-- Map Demo Link --%>
  <div class="max-w-6xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-700 pt-6">
      <a href="/map-demo" class="text-gray-500 hover:text-gray-300 text-sm">
        Map Rendering Demo &rarr;
      </a>
    </div>
  </div>
</div>
